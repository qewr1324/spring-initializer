{
	"name": "spring-initializer",
	"type": "module",
	"displayName": "Spring Initializer",
	"description": "🌵 Spring Initializer - Auto code generator for Spring Boot projects for 💠 VSCode.",
	"version": "1.0.0",
	"private": false,
	"publisher": "GhurbeSABZI",
	"packageManager": "bun@1.3.14",
	"author": "GhurbeSABZI <naiad.arts.studio@gmail.com>",
	"icon": "res/facet-icon-big.png",
	"license": "MIT",
	"homepage": "https://github.com/qewr1324/spring-initializer#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/qewr1324/spring-initializer"
	},
	"bugs": {
		"url": "https://github.com/qewr1324/spring-initializer/issues"
	},
	"engines": {
		"vscode": "^1.85.0"
	},
	"keywords": [
		"spring",
		"spring-boot",
		"spring-initializr",
		"project-generator",
		"vscode extension"
	],
	"categories": [
		"Programming Languages",
		"Other"
	],
	"galleryBanner": {
		"color": "#6DB33F",
		"theme": "dark"
	},
	"preview": false,
	"qna": "marketplace",
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./dist/extension.cjs",
	"contributes": {
		"commands": [
			{
				"command": "spring-initializer.open",
				"title": "Spring Initializer: New Project",
				"icon": "$(project)"
			}
		],
		"menus": {
			"explorer/context": [
				{
					"command": "spring-initializer.open",
					"group": "navigation@1"
				}
			],
			"commandPalette": [
				{
					"command": "spring-initializer.open",
					"when": "true"
				}
			]
		},
		"configuration": {
			"title": "Spring Initializer",
			"properties": {
				"springInitializer.enable": {
					"type": "boolean",
					"default": true,
					"description": "Enable/disable Spring Initializer"
				},
				"springInitializer.defaultGroupId": {
					"type": "string",
					"default": "com.example",
					"description": "Default Group ID for new projects"
				},
				"springInitializer.defaultJavaVersion": {
					"type": "string",
					"default": "21",
					"enum": [
						"21",
						"17",
						"11"
					],
					"description": "Default Java version for new projects"
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "bun run build",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"build": "tsdown src/extension.ts --external vscode",
		"dev": "bun run build --watch --sourcemap",
		"prepare": "echo 'Skipping update'",
		"update": "echo 'Skipping vscode-ext-gen'",
		"lint": "eslint .",
		"test": "vitest",
		"typecheck": "tsc --noEmit",
		"release": "bumpp",
		"ext:package": "vsce package --no-dependencies",
		"ext:publish": "vsce publish --no-dependencies"
	},
	"devDependencies": {
		"@types/vscode": "^1.85.0",
		"@types/node": "^20.0.0",
		"typescript": "^5.3.0",
		"@antfu/eslint-config": "^6.7.3",
		"@antfu/ni": "^28.0.0",
		"@vscode/vsce": "^3.7.1",
		"bumpp": "^10.3.2",
		"eslint": "^9.39.2",
		"ovsx": "^0.10.7",
		"reactive-vscode": "^1.0.0-beta.2",
		"taze": "^19.9.2",
		"tsdown": "^0.19.0-beta.3",
		"vite": "^7.3.0",
		"vitest": "^4.0.16",
		"vscode-ext-gen": "^1.5.1",
		"vsxpub": "^0.1.2"
	},
	"dependencies": {
		"adm-zip": "^0.6.0"
	}
}
